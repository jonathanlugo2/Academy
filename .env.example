# Copia este archivo a .env y rellena los valores de tu proyecto de Supabase
# (Dashboard → Project Settings → API). La anon key es pública por diseño;
# NUNCA pongas aquí la service role key: todo lo que empieza por VITE_ acaba en el bundle.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima
